PROJECT_NAME=AI Exercise Prescription Platform
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# Docker 镜像可按部署网络切换到企业/云厂商镜像仓库，默认使用官方镜像。
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.12.1
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine

POSTGRES_DB=exercise
POSTGRES_USER=exercise
POSTGRES_PASSWORD=exercise
DATABASE_URL=postgresql+psycopg://exercise:exercise@postgres:5432/exercise

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=exercise_prescription_knowledge
RAG_VECTOR_SEARCH_ENABLED=true
RAG_EMBEDDING_DIMENSION=64

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exercise-platform

# 开发默认使用 mock；生产接入阿里云百炼/DashScope 兼容 OpenAI 协议时改为 aliyun。
LLM_PROVIDER=mock
# 阿里云百炼兼容模式示例：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 只通过部署环境变量注入真实 API Key，禁止提交到仓库。
LLM_API_KEY=
# 阿里云百炼 / DashScope 也可使用该别名注入真实 API Key。
DASHSCOPE_API_KEY=
ALIYUN_API_KEY=
# 阿里云文本模型示例：qwen3.7-max；开发 mock 也可保留该默认值。
LLM_MODEL=qwen3.7-max
# 多模态模型供后续体测报告、动作图片/视频理解等模块使用。
LLM_MULTIMODAL_MODEL=qwen3.6-plus
MULTIMODAL_MODEL=qwen3.6-plus
# 简单问答、非关键摘要和低风险辅助说明可配置为本地 Ollama。
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=gemma

# OCR 仅在扫描件/图片型资料无法直接解析文本时启用；推荐服务器部署 PaddleOCR。
OCR_PROVIDER=paddleocr
OCR_ENABLED=false

# 生产建议使用 JSON 日志，便于容器平台、ELK/Loki/云日志采集。
LOG_LEVEL=INFO
LOG_FORMAT=json
# 可填写企业微信、飞书、钉钉或自建告警网关地址；不要提交带密钥的真实 URL。
ERROR_ALERT_WEBHOOK_URL=

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000/api/v1
